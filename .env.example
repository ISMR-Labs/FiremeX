# ---- Twilio (required for emergency calls) --------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15005550006

# Public HTTPS base URL Twilio can reach for TwiML + acknowledgement webhooks.
# In development use a tunnel (e.g. `cloudflared tunnel --url http://localhost:8000`).
FIREMEX_PUBLIC_BASE_URL=https://firemex.example.com

# Validate the X-Twilio-Signature header on inbound webhooks. Keep this on.
FIREMEX_VALIDATE_TWILIO_SIGNATURE=true

# Bearer token letting Prometheus scrape /metrics without a dashboard login.
# Leave empty and /metrics will require a session instead. Metrics carry camera
# names and incident counts, so the endpoint is never left wide open.
FIREMEX_METRICS_TOKEN=
# How long a dashboard login lasts.
FIREMEX_SESSION_TTL_HOURS=12

# ---- Storage -------------------------------------------------------------
FIREMEX_DATABASE_URL=postgresql+psycopg2://firemex:firemex@localhost:5432/firemex
FIREMEX_REDIS_URL=redis://localhost:6379/0

# ---- Detection -----------------------------------------------------------
# Backend: stub | ultralytics | onnx
FIREMEX_DETECTOR_BACKEND=stub
FIREMEX_MODEL_PATH=weights/firemex-yolov26s.pt
FIREMEX_DEVICE=cpu
FIREMEX_BATCH_SIZE=8
FIREMEX_BATCH_TIMEOUT_MS=80
FIREMEX_IMAGE_SIZE=640

# ---- Runtime -------------------------------------------------------------
FIREMEX_CONFIG_PATH=config.yaml
FIREMEX_STORAGE_DIR=./data
FIREMEX_LOG_LEVEL=INFO
FIREMEX_LOG_JSON=true
# Shadow mode: detect, record and log incidents but never place a call.
# Run like this for 2-4 weeks on a new site before enabling alerts.
FIREMEX_SHADOW_MODE=true
FIREMEX_API_HOST=0.0.0.0
FIREMEX_API_PORT=8000
